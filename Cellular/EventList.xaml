<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cellular.EventList"
             xmlns:local="clr-namespace:Cellular.ViewModel"
             x:DataType="local:SessionListViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add Event" Clicked="AddEvent" Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">

            <Image Source="logo.png"
                   HeightRequest="185"
                   Aspect="AspectFit"
                   SemanticProperties.Description="RevMetrix Bowling Ball Logo" />

            <Label Text="Events"
                   x:Name="labelname"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <StackLayout Orientation="Vertical"
                         x:Name="_eventlist"
                         BindableLayout.ItemsSource="{Binding Events}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:Event">
                        <Grid ColumnDefinitions="*, Auto" Margin="0,4" ColumnSpacing="4">

                            <!-- Tappable info card — navigates to the event's sessions -->
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                                          Tapped="OnEventCardTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding LongName}"
                                           FontSize="15"
                                           FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Enabled}"
                                                         Value="False">
                                                <Setter Property="TextColor" Value="Red" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding NickName,   StringFormat='Nickname: {0}'}" TextColor="Gray" FontSize="13" />
                                    <Label Text="{Binding Type,       StringFormat='Type: {0}'}"     TextColor="Gray" FontSize="13" />
                                    <Label Text="{Binding Location,   StringFormat='Location: {0}'}" TextColor="Gray" FontSize="13" />
                                    <Label Text="{Binding WeekDay,    StringFormat='Day: {0}'}"      TextColor="Gray" FontSize="13" />
                                    <Label Text="{Binding StartTime,  StringFormat='Start: {0}'}"    TextColor="Gray" FontSize="13" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Edit button -->
                            <Button Grid.Column="1"
                                    Text="&#x270F;"
                                    FontSize="16"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnEditEventClicked"
                                    WidthRequest="44"
                                    Style="{StaticResource AccentButton}"
                                    TextColor="White"
                                    VerticalOptions="Center" />

                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
